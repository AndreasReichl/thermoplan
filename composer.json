{
    "name": "statamic/statamic",
    "type": "project",
    "description": "Statamic",
    "keywords": [
        "statamic",
        "cms",
        "flat file",
        "laravel"
    ],
    "require": {
        "php": "^8.3",
        "anakadote/statamic-recaptcha": "^1.0",
        "aryehraber/statamic-logbook": "^4.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "ndx/statamic-bard-color-picker": "^3.0",
        "pecotamic/sitemap": "^2.0",
        "statamic/cms": "^6.40",
        "stoffelio/statamic-404-logger": "^2.0",
        "takepart-media/statamic-oreos": "^1.3",
        "teamnovu/statamic-images-missing-alt": "^2.0",
        "webographen/statamic-admin-log": "^2.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Takepart\\Oreos\\Compat\\": "overrides/oreos/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-update-cmd": [
            "Statamic\\Console\\Composer\\Scripts::preUpdateCmd"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan statamic:install --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "takepart-media/statamic-oreos"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "pixelfear/composer-dist-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
